{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] }
    ]
  }
}
